# Resend API key; if missing, server refuses to send requests.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Admin access (set strong secrets in Render, never in Git)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Render PostgreSQL internal connection URL
DATABASE_URL=

# Cloudinary image storage (secret values only in Render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

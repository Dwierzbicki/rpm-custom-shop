# PostgreSQL on Render; never commit actual credentials.
DATABASE_URL=
# Use "require" only when the DB server has a trusted TLS certificate.
DATABASE_SSL=

# Admin access (session secret: minimum 32 characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Customer Google OAuth (APP_URL is your public HTTPS origin, no trailing slash).
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CUSTOMER_SESSION_SECRET=

# Order mail modes: mock or test. Production delivery is currently disabled.
EMAIL_MODE=mock
EMAIL_FROM=
EMAIL_TEST_RECIPIENT=
RESEND_API_KEY=

# Inquiries and Polish company lookup.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
GUS_BIR_API_KEY=

# Product images on Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
